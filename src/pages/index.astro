---
import Layout from "../layouts/Layout.astro";
import { loadQuery } from "../sanity/lib/load-query";
import { urlForImage } from "../sanity/lib/url-for-image";

const { data: posts } = await loadQuery<
	{
		title: string;
		slug: { current: string };
		mainImage?: { alt?: string };
		author?: {
			name: string;
		};
		publishedAt: string;
		excerpt?: string;
	}[]
>({
	query: `*[_type == "post"] | order(publishedAt desc) {
		title,
		slug,
		mainImage,
		author->{
			name
		},
		publishedAt
	}`,
});
---

<Layout>
	<div>
		<h1>Welcome To Accuguide&#39;s Blog</h1>

		<div>
			{posts.map((post) => (
				<article>
					<a href={`/post/${post.slug.current}`}>
						<div class="max-w-lg">
							<img
								src={urlForImage(post.mainImage!)?.width(800).height(400).url()}
								alt={post.mainImage?.alt || post.title}
								class="rounded-lg"
							/>
						</div>
						<div>
							<h2>{post.title}</h2>
							<p class="secondary-text font-semibold">By {post.author!.name}</p>
							<p class="mb-0 secondary-text text-sm -mt-4">
								{new Date(post.publishedAt).toLocaleDateString('en-US', {
									year: 'numeric',
									month: 'long',
									day: 'numeric'
								})}
							</p>
						</div>
					</a>
				</article>
			))}
		</div>
	</div>
</Layout>
